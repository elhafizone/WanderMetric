# WanderMetric — environment contract
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Values below are placeholders only; no real secret belongs in this file.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin. Drives canonical URLs, Open Graph, robots and sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Supabase  (Project Settings → API)
# ---------------------------------------------------------------------------
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# SERVER ONLY. Bypasses Row Level Security — never prefix with NEXT_PUBLIC_,
# never import into a Client Component, never commit.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Scheduled jobs  (Phase 7+)
# ---------------------------------------------------------------------------
# Shared secret guarding /api/internal/* endpoints invoked by cron.
# CRON_SECRET=""

# ---------------------------------------------------------------------------
# Affiliate providers  (Phase 6 — not integrated yet)
# ---------------------------------------------------------------------------
# TRAVELPAYOUTS_MARKER=""
# TRAVELPAYOUTS_API_TOKEN=""

# ---------------------------------------------------------------------------
# Social publishing  (Phase 8 — not integrated yet)
# ---------------------------------------------------------------------------
# PINTEREST_APP_ID=""
# PINTEREST_APP_SECRET=""
